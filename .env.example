# Copy to .env (gitignored, never committed) and fill in real values.
# See src/config/env.validation.ts for what's actually required at boot, and
# the root CLAUDE.md's "Database and migrations" section for how DB_* is used.

# --- Database (required) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=user
DB_PASSWORD=password
DB_DATABASE=havit
# Azure Postgres requires TLS (the default below). A local Postgres container
# does not speak SSL — set this to false for local dev only.
DB_SSL=true

# --- Auth (required) ---
JWT_SECRET=change-me

# --- Redis (optional — B6 read-through cache) ---
# Unset or unreachable Redis never breaks the API: RedisCacheService falls
# back to Postgres on any cache miss/error. See performance/REDIS.md.
# REDIS_URL=redis://localhost:6379

# --- Optional integrations (safe to leave unset for local dev) ---
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET_NAME=
# CLOUDFLARE_R2_PUBLIC_URL=
# OPENAI_API_KEY=
# PORT=3000
# CORS_ORIGINS=
# PUBLIC_API_URL=
